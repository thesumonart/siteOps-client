# ---------------------------------------------------------------------------
# SiteOps dashboard environment configuration
#
# Copy to `.env.local` and fill in. Everything in this file is browser-visible:
# NEXT_PUBLIC_* values are inlined into the JavaScript bundle at build time and
# served to every visitor. A secret placed here is a published secret.
#
# Server configuration — the database URI, the auth secret, the mail API key —
# belongs to siteOps-server and is never read by this project. See that repo's
# `.env.example`.
# ---------------------------------------------------------------------------

# Origin of the SiteOps API this dashboard talks to. Every request goes here.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Public origin of this app. Used to build absolute links back to itself.
NEXT_PUBLIC_APP_URL=http://localhost:3000
